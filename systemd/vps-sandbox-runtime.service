[Unit]
Description=Dedicated rootless VPS MCP workload runtime
Requires=vps-sandbox-runtime.socket
After=vps-sandbox-runtime.socket

[Service]
Type=simple
User=vps-sandbox
Environment=USER=vps-sandbox
Environment=HOME=/var/lib/vps-sandbox
EnvironmentFile=/etc/vps-sandbox/runtime.env
ExecStart=/usr/bin/node /usr/local/libexec/vps-mcp/vps-sandbox-runtime.mjs
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
# The agent is a control plane; rootless conmon/container processes must survive its restart.
KillMode=process
NoNewPrivileges=no
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
Delegate=cpu memory pids
DelegateSubgroup=init.scope
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
# Podman must preserve setuid/setgid metadata while extracting rootless image layers.
# The runtime runs as vps-sandbox; workload containers remain rootless and separately confined.
RestrictSUIDSGID=no
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/fuse rwm
DeviceAllow=/dev/net/tun rw
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
ReadWritePaths=/var/lib/vps-sandbox
ReadWritePaths=-/srv/vps-mcp-workspaces -/var/lib/vps-mcp/task-workspaces/worktrees
