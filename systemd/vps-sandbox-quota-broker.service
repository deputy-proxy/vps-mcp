[Unit]
Description=Restricted root task workspace project-quota broker
Requires=vps-sandbox-quota-broker.socket
After=vps-sandbox-quota-broker.socket
[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/node /usr/local/libexec/vps-mcp/vps-sandbox-quota-broker.mjs
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
TimeoutStopSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
RestrictSUIDSGID=yes
PrivateDevices=no
DevicePolicy=closed
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
# This broker must perform bind mounts in the host mount namespace so the
# rootless runtime can consume them. Filesystem namespace directives such as
# ProtectSystem, ProtectHome, PrivateTmp and ReadWritePaths are intentionally
# absent: systemd would isolate the broker in a private mount namespace.
UMask=0077
