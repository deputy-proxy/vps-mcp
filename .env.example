# Bind the Node process to localhost. Put Caddy/Nginx in front for HTTPS.
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Choose one: token (local/private), oauth (public ChatGPT endpoint), none (loopback only).
MCP_AUTH_MODE=token
MCP_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Required for MCP_AUTH_MODE=oauth. Use the exact public MCP URL, including /mcp.
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Configure an OAuth 2.1/OIDC provider that supports Authorization Code + PKCE S256,
# refresh tokens, resource/audience binding, and ChatGPT CIMD or DCR client registration.
OAUTH_ISSUER_URL=https://identity.example.com/
OAUTH_AUDIENCE=https://mcp.example.com/mcp
# Optional; defaults to .well-known/jwks.json relative to OAUTH_ISSUER_URL.
OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPES=mcp

MCP_ALLOWED_ROOTS=/srv,/var/lib/vps-mcp
MCP_DATA_DIR=/var/lib/vps-mcp
MCP_MAX_REQUEST_BYTES=2097152
MCP_DEFAULT_COMMAND_TIMEOUT_MS=30000
MCP_MAX_COMMAND_TIMEOUT_MS=900000
MCP_MAX_OUTPUT_BYTES=1048576
