# Bind the Node process to localhost. Put Caddy/Nginx in front for HTTPS.
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Choose one: token (local/private), oauth (public endpoint), none (loopback only).
MCP_AUTH_MODE=token
MCP_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Required for MCP_AUTH_MODE=oauth. Use the exact public MCP URL, including /mcp.
MCP_PUBLIC_URL=https://194.163.133.147/mcp

# WorkOS AuthKit issuer. Keep the exact issuer identifier returned by discovery.
OAUTH_ISSUER_URL=https://stalwart-insight-17-staging.authkit.app
OAUTH_AUDIENCE=https://194.163.133.147/mcp
# Optional. When omitted, jwks_uri is read from the issuer's OIDC discovery document.
OAUTH_JWKS_URL=
# Leave empty for WorkOS AuthKit CIMD/DCR clients: their standard scopes are
# openid, profile, email and offline_access. These are identity/refresh scopes,
# not VPS permissions. Resource access is bound by the aud claim. Only set this
# when the AuthKit environment is explicitly configured to issue extra scopes.
OAUTH_REQUIRED_SCOPES=

# Optional additional browser origins. ChatGPT web origins are allowed automatically.
# Use comma-separated exact HTTPS origins; localhost HTTP origins are allowed for development.
MCP_CORS_ORIGINS=

MCP_ALLOWED_ROOTS=/srv,/var/lib/vps-mcp
MCP_DATA_DIR=/var/lib/vps-mcp
MCP_MAX_REQUEST_BYTES=2097152
MCP_DEFAULT_COMMAND_TIMEOUT_MS=30000
MCP_MAX_COMMAND_TIMEOUT_MS=900000
MCP_MAX_OUTPUT_BYTES=1048576

# Managed Git repository registry and bare clone cache resource limits.
REPOSITORY_DEV_HOST_SUFFIX=.dev.cr8or.be
REPOSITORY_MAX_COUNT=250
REPOSITORY_MAX_CACHE_BYTES=21474836480
REPOSITORY_CACHE_STALE_AFTER_MS=604800000
# Required status-check contexts enforced on main/development. Comma-separated.
REPOSITORY_REQUIRED_STATUS_CHECKS=quality
# Optional GitHub fine-grained PAT or GitHub App installation token.
# Read branch rulesets with Metadata: read; apply managed rulesets with Administration: write.
# REPOSITORY_GITHUB_TOKEN=
# Optional trusted executable implementing the Git credential-helper protocol.
# REPOSITORY_GIT_CREDENTIAL_HELPER=/usr/local/bin/git-credential-vps-mcp
